# Runtime data - this app's own SQLite db, backups, and the Objectives file.
# Never distribute someone else's live admin data.
webui-data/

# Python
__pycache__/
*.pyc
.venv/

# Node / frontend build output
node_modules/
frontend/dist/

# Editor / OS cruft
.DS_Store
.vscode/
.idea/

# Claude Code local session config - machine-specific, not part of the app
.claude/

# Dev-only fixtures used while building the .ini/SandboxVars parsers - not
# read by the app itself
Test Files/

# Local env overrides, if anyone still uses one despite docker-compose.yml
# being the single source of config
.env
.env.local

# Maintainer's source image for the Base Map (backend/app/map/b42_map.jpg,
# ~206MB) - exceeds GitHub's 100MB per-file push limit, and isn't needed for
# normal operation anyway: the app ships with the already-tiled output
# (backend/app/map/base_tiles/) and a matching default calibration baked in.
# Only needed locally if you want to re-tile from scratch via the Settings
# tab's "Tile Base Map" button.
backend/app/map/b42_map.jpg
